# Read by scripts/package-appimage.sh when the app ships an AppImage
# (`appimage = true` under [package.metadata.pkgforge] in Cargo.toml).
#
# egui draws through glow, and detection alone bundles GLX and gallium but
# no libEGL, no dri/ and no gbm, which leaves no Wayland path and no driver
# behind the GL it carries. An app that draws without GL on a host that
# has none sets USE_HOST_DRIVERS=1 instead.
DEPLOY_OPENGL=1
